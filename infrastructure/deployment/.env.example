# Values for docker compose itself (image source, domain, calls relay). Copy to .env in this
# folder (never commit it). The app's own settings are in .env.production.
REGISTRY=ghcr.io/your-org
IMAGE_TAG=v1.0.0
SMA_DOMAIN=chat.example.com
API_REPLICAS=2
WORKER_REPLICAS=2

# Calls relay (coturn). Same secret as TURN_SHARED_SECRET in .env.production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TURN_SHARED_SECRET=CHANGE_ME
# The server's public IPv4 address.
TURN_EXTERNAL_IP=203.0.113.10
