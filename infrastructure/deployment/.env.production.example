# Production configuration for the api, worker and migrate containers. Copy to
# .env.production, fill in every value, keep it out of version control (mode 600).
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=https://chat.example.com

# PostgreSQL (bundled service "postgres", or a managed instance). Size the pool per process:
# replicas × connection_limit must stay well below the server's max_connections.
DATABASE_URL=postgresql://sma:CHANGE_ME@postgres:5432/sma?schema=public&connection_limit=20&pool_timeout=10
REDIS_URL=redis://redis:6379/0

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME
COOKIE_SECURE=true
MFA_ISSUER=SMA
MFA_REQUIRED_FOR_PRIVILEGED=true
OPENAPI_ENABLED=false

# Object storage (S3 or compatible): private bucket with versioning and encryption at rest.
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_REGION=eu-west-1
S3_BUCKET=sma-media-prod
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKET=false

MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Metrics on internal ports 9464 (api) / 9465 (worker); scrape them from the private network only.
METRICS_ENABLED=true
# METRICS_TOKEN=at-least-32-random-characters
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Web Push (VAPID): npx web-push generate-vapid-keys (keep the private key secret).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# The public address (links in emails, quotes, pay pages, reminders).
WEB_APP_URL=https://chat.example.com

# Email (invoices, quotes, reminders, password resets) through a real provider with your domain
# verified (SPF, DKIM, DMARC): see docs/operations/email.md.
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# MAIL_FROM=SMA <no-reply@chat.example.com>

# Calls across the internet: STUN + your own TURN relay (coturn service).
CALL_ICE_SERVERS=[{"urls":"stun:chat.example.com:3478"}]
TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
# Same value as TURN_SHARED_SECRET in .env (compose).
TURN_SHARED_SECRET=CHANGE_ME

# Big group calls through LiveKit (profile "livekit"); leave unset to keep calls device to device.
# LIVEKIT_URL=wss://livekit.chat.example.com
# LIVEKIT_API_KEY=sma-livekit
# LIVEKIT_API_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS

# Error tracking (Sentry or self-hosted GlitchTip). Unset: errors are only logged.
# SENTRY_DSN=https://KEY@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# WhatsApp (Meta Cloud API) and SMS (Twilio) for campaigns and invoice reminders:
# see docs/operations/messaging-channels.md. They can also be set in the app (Integrations).
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Map previews: your own tile provider for production traffic (OpenStreetMap's free servers
# are for light use only), e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
