# Scheduled backups (service "backup"). Copy to .env.backup (mode 600, never commit).
# Read-only database user is enough: CREATE ROLE sma_backup LOGIN PASSWORD '...'; GRANT pg_read_all_data TO sma_backup;
BACKUP_DATABASE_URL=postgresql://sma_backup:CHANGE_ME@postgres:5432/sma
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Off-site copy: an S3-compatible bucket in ANOTHER account/region (versioning + object lock on).
# Backblaze B2, Cloudflare R2, Wasabi, AWS S3… The key must only be able to write this bucket.
BACKUP_S3_BUCKET=sma-backups
BACKUP_S3_PREFIX=prod
BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-central-003

# Optional: also copy uploaded files from the media bucket (same provider and key access only).
# BACKUP_MEDIA_SOURCE_BUCKET=sma-media-prod

# Dead man's switch: pinged after each good backup (and /fail after a bad one), e.g. a free
# healthchecks.io check set to "every 1 day, grace 2 hours": you get an email if backups stop.
BACKUP_HEARTBEAT_URL=https://hc-ping.com/CHANGE_ME
