# LiveKit (profile "livekit"). Copy to .env.livekit (mode 600, never commit).
# "<api key>: <api secret>" — put the same pair in .env.production as LIVEKIT_API_KEY /
# LIVEKIT_API_SECRET. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LIVEKIT_KEYS="sma-livekit: CHANGE_ME_AT_LEAST_32_CHARACTERS"
