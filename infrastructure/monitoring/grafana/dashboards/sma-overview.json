      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sma-prometheus"
          },
          "expr": "sum(rate(sma_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(sma_http_requests_total[5m])), 1e-9)"
        }
      ]
    },
