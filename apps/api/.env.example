# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS and the Socket.IO handshake.
CORS_ORIGINS=http://localhost:3000
# Number of reverse-proxy hops to trust for client IPs (0 when exposed directly).
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://storeline:storeline_dev_password@127.0.0.1:15432/storeline?schema=public
REDIS_URL=redis://127.0.0.1:16379/0

# >= 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
# Secure cookies require HTTPS; only disable for plain-http local development.
COOKIE_SECURE=false

# 32 random bytes, base64. Encrypts MFA secrets at the application level.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
MFA_ISSUER=SMA
MFA_REQUIRED_FOR_PRIVILEGED=true

# Expose Swagger UI at /api/docs (disable in production unless protected).
OPENAPI_ENABLED=true

# Shared password for seeded demo accounts (development only, >= 12 chars).
SEED_PASSWORD=

# Object storage (S3-compatible). Local dev uses SeaweedFS from compose.yaml.
S3_ENDPOINT=http://127.0.0.1:18333
S3_PUBLIC_ENDPOINT=http://127.0.0.1:18333
S3_REGION=us-east-1
S3_BUCKET=storeline-media
S3_ACCESS_KEY_ID=storeline_dev_access_key
S3_SECRET_ACCESS_KEY=storeline_dev_secret_key_change_me
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Media limits (business policy can lower per-kind limits).
MEDIA_PLATFORM_MAX_MB=1024

# Malware scanning (clamd from compose.yaml).
MALWARE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310

# Emergency escalation sweep interval (ms). Alerts escalate within this delay after their deadline.
EMERGENCY_SWEEP_INTERVAL_MS=5000

# Bulk campaign dispatcher round interval (ms) and maximum batch size.
CAMPAIGN_DISPATCH_INTERVAL_MS=1000
CAMPAIGN_BATCH_SIZE=200

# Prometheus metrics on internal ports (API / worker). Keep them off the public network.
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
METRICS_WORKER_PORT=9465
# Optional: METRICS_TOKEN=<at least 32 random characters>
# Optional tracing: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Web Push (VAPID). Generate once per environment: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
