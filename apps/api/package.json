{
  "name": "@storeline/api",
  "version": "0.1.0",
  "private": true,
  "description": "Storeline API (HTTP + WebSocket) and background worker",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:sync-roles": "tsx src/cli/sync-roles.ts",
    "db:demo": "tsx prisma/demo-data.ts",
    "accounts:apply": "tsx prisma/apply-accounts.ts",
    "db:demo-sales": "tsx prisma/demo-sales.ts",
    "db:demo-crm": "tsx prisma/demo-crm.ts",
    "db:demo-features": "tsx prisma/demo-features.ts",
    "db:demo-business-crm": "tsx prisma/demo-business-crm.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/resources": "~2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.7.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@storeline/shared": "^0.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.1.0",
    "otpauth": "^9.5.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@prisma/config": "^6.19.3",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  }
}
