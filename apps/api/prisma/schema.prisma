// Storeline data model. See docs/architecture/data-model.md.
// Conventions: UUID ids, timestamptz(3), every business-owned row carries businessId.

generator client {
  provider        = "prisma-client-js"
  // "native" for local development; debian-openssl-3.0.x for the node:24-bookworm-slim images.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  // Loads `include`d relations with one SQL query (LATERAL joins) instead of one per relation.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

enum UserKind {
  INTERNAL
  EXTERNAL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  username            String     @unique @db.VarChar(32)
  displayName         String     @db.VarChar(80)
  kind                UserKind   @default(INTERNAL)
  status              UserStatus @default(ACTIVE)
  passwordHash        String
  mustChangePassword  Boolean    @default(false)
  passwordChangedAt   DateTime?  @db.Timestamptz(3)
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(3)
  /// AES-256-GCM encrypted TOTP secret (see infra/crypto). Never selected outside AuthModule.
  mfaSecretEnc        String?
  mfaPendingSecretEnc String?
  mfaEnabledAt        DateTime?  @db.Timestamptz(3)
  /// Last accepted TOTP time step, prevents code replay.
  mfaLastUsedStep     BigInt?
  lastActiveAt        DateTime?  @db.Timestamptz(3)
  /// Set when an admin deletes the account: it is anonymised and hidden; messages stay as "Deleted user".
  deletedAt           DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)

  contact               UserContact?
  businessMemberships   BusinessMembership[]
  storeMemberships      StoreMembership[]
  roleAssignments       RoleAssignment[]             @relation("assignee")
  grantedAssignments    RoleAssignment[]             @relation("grantor")
  sessions              Session[]
  conversationMembers   ConversationMember[]
  sentMessages          Message[]
  reactions             MessageReaction[]
  starredMessages       StarredMessage[]
  createdConversations  Conversation[]               @relation("creator")
  mediaAssets           MediaAsset[]
  auditEntries          AuditLog[]
  emergencyContacts     EmergencyContact[]
  reportedIncidents     EmergencyIncident[]          @relation("incidentReporter")
  acknowledgedIncidents EmergencyIncident[]          @relation("incidentAcknowledger")
  resolvedIncidents     EmergencyIncident[]          @relation("incidentResolver")
  incidentAlerts        EmergencyIncidentRecipient[]
  createdCampaigns      BulkCampaign[]               @relation("campaignCreator")
  campaignDeliveries    BulkCampaignRecipient[]
  suppressions          CampaignSuppression[]        @relation("suppressedUser")
  devices               Device[]
  notificationPrefs     NotificationPreference?
  passwordResets        PasswordResetToken[]
  ownedLeads            Lead[]                       @relation("leadOwner")
  createdLeads          Lead[]                       @relation("leadCreator")
  leadActivities        LeadActivity[]
  addedStoreCustomers   StoreCustomer[]
  customerCampaigns     CustomerCampaign[]
  hiddenMessages        HiddenMessage[]
  pollVotes             PollVote[]
  eventResponses        EventResponse[]
  broadcastRecipientOf  BroadcastRecipient[]
  statusPosts           StatusPost[]
  statusViews           StatusView[]
  assignedTasks         StoreTask[]                  @relation("taskAssignee")
  createdTasks          StoreTask[]                  @relation("taskCreator")
  completedTasks        StoreTask[]                  @relation("taskCompleter")
  shifts                Shift[]                      @relation("shiftUser")
  createdShifts         Shift[]                      @relation("shiftCreator")
  ownedDeals            Deal[]                       @relation("dealOwner")
  createdDeals          Deal[]                       @relation("dealCreator")
  createdInvoices       Invoice[]                    @relation("invoiceCreator")
  recordedPayments      Payment[]                    @relation("paymentRecorder")
  salesTargets          SalesTarget[]                @relation("salesTargets")
}

/// Private contact details. Only read by explicitly authorized, audited flows (ADR-0006).
model UserContact {
  userId          String    @id @db.Uuid
  email           String?   @unique @db.VarChar(254)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  phone           String?   @db.VarChar(16)
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  lastUsedAt    DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  revokeReason  String?        @db.VarChar(64)
  mfaVerifiedAt DateTime?      @db.Timestamptz(3)
  userAgent     String?        @db.VarChar(256)
  /// SHA-256 of client IP (no raw IPs stored on sessions).
  ipHash        String?        @db.VarChar(64)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  device        Device?

  @@index([userId, revokedAt])
}

/// Rotating refresh tokens. A session is the token family; reuse of a consumed token revokes it.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// One-time "forgot password" links. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  /// Keyed hash of the requesting IP (no raw IPs).
  requestedIp String?   @db.VarChar(64)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StoreStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

model Business {
  id            String         @id @default(uuid()) @db.Uuid
  slug          String         @unique @db.VarChar(48)
  name          String         @db.VarChar(120)
  status        BusinessStatus @default(ACTIVE)
  timeZone      String         @default("UTC") @db.VarChar(64)
  locale        String         @default("en") @db.VarChar(10)
  /// BusinessPolicy JSON (validated by @storeline/shared businessPolicySchema).
  policy        Json           @default("{}")
  /// { line1, line2, city, region (state), postalCode, country (ISO alpha-2) }
  address       Json?
  /// Public profile (see PlaceDetails in @storeline/shared).
  description   String?        @db.VarChar(500)
  phone         String?        @db.VarChar(16)
  email         String?        @db.VarChar(254)
  website       String?        @db.VarChar(500)
  mapUrl        String?        @db.VarChar(500)
  /// { facebook?, instagram?, x?, linkedin?, tiktok?, youtube?, whatsapp? } (http(s) links)
  socialLinks   Json           @default("{}")
  /// Logo re-encoded to 256px WebP by the API (never the uploaded bytes).
  logo          Bytes?
  logoUpdatedAt DateTime?      @db.Timestamptz(3)

  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?          @db.Timestamptz(3)
  /// SMA's own internal team (Sales & Marketing chats). Never listed as a customer business.
  internal          Boolean            @default(false)
  /// The sales lead this business came from, when it was won by the sales team.
  sourceLead        Lead?              @relation("leadCustomer")
  storeCustomers    StoreCustomer[]
  customerCampaigns CustomerCampaign[]
  /// Set when the platform deletes the business: hidden everywhere, history kept.
  deletedAt         DateTime?          @db.Timestamptz(3)

  stores          Store[]
  departments     Department[]
  memberships     BusinessMembership[]
  roles           Role[]
  roleAssignments RoleAssignment[]
  conversations   Conversation[]
  mediaAssets     MediaAsset[]
  incidents       EmergencyIncident[]
  campaigns       BulkCampaign[]
  suppressions    CampaignSuppression[]
  quota           TenantQuota?
  statusPosts     StatusPost[]
  /// CRM: what SMA sold to this customer and billed them.
  deals           Deal[]                @relation("customerDeals")
  invoices        Invoice[]             @relation("customerInvoices")
}

model TenantQuota {
  businessId        String   @id @db.Uuid
  maxUsers          Int      @default(5000)
  maxStores         Int      @default(500)
  maxStorageBytes   BigInt   @default(107374182400)
  messagesPerMinute Int      @default(3000)
  maxCampaignSize   Int      @default(100000)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  business          Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
}

model Store {
  id            String      @id @default(uuid()) @db.Uuid
  businessId    String      @db.Uuid
  code          String      @db.VarChar(16)
  name          String      @db.VarChar(120)
  status        StoreStatus @default(ACTIVE)
  timeZone      String?     @db.VarChar(64)
  address       Json?
  /// Public profile (see PlaceDetails in @storeline/shared).
  description   String?     @db.VarChar(500)
  phone         String?     @db.VarChar(16)
  email         String?     @db.VarChar(254)
  website       String?     @db.VarChar(500)
  mapUrl        String?     @db.VarChar(500)
  /// { facebook?, instagram?, x?, linkedin?, tiktok?, youtube?, whatsapp? } (http(s) links)
  socialLinks   Json        @default("{}")
  /// Logo re-encoded to 256px WebP by the API (never the uploaded bytes).
  logo          Bytes?
  logoUpdatedAt DateTime?   @db.Timestamptz(3)

  createdAt                  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt                 DateTime? @db.Timestamptz(3)
  /// Set when an admin deletes the store: hidden everywhere, history kept.
  deletedAt                  DateTime? @db.Timestamptz(3)
  /// Seconds an emergency alert waits for acknowledgement before escalating (15-1800).
  emergencyAckTimeoutSeconds Int       @default(120)

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  memberships       StoreMembership[]
  departments       Department[]
  roleAssignments   RoleAssignment[]
  conversations     Conversation[]
  emergencyContacts EmergencyContact[]
  incidents         EmergencyIncident[]
  customers         StoreCustomer[]
  tasks             StoreTask[]
  shifts            Shift[]
  statusPosts       StatusPost[]

  @@unique([businessId, code])
  /// Lets child tables reference (businessId, storeId) so a store can never be paired with another tenant.
  @@unique([businessId, id])
}

model Department {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @db.Uuid
  storeId    String?           @db.Uuid
  name       String            @db.VarChar(80)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  store      Store?            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  members    StoreMembership[]

  @@unique([businessId, storeId, name])
}

model BusinessMembership {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @db.Uuid
  userId     String           @db.Uuid
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId, status])
}

model StoreMembership {
  id           String           @id @default(uuid()) @db.Uuid
  businessId   String           @db.Uuid
  storeId      String           @db.Uuid
  userId       String           @db.Uuid
  departmentId String?          @db.Uuid
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  store        Store            @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([storeId, userId])
  @@index([userId, status])
}

// ───────────────────────────── Access control ─────────────────────────────

enum ScopeType {
  PLATFORM
  BUSINESS
  STORE
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  /// null for system roles.
  businessId    String?          @db.Uuid
  key           String           @db.VarChar(48)
  name          String           @db.VarChar(80)
  description   String?          @db.VarChar(300)
  isSystem      Boolean          @default(false)
  allowedScopes ScopeType[]
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  business      Business?        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  permissions   RolePermission[]
  assignments   RoleAssignment[]

  @@unique([businessId, key])
}

model RolePermission {
  roleId     String @db.Uuid
  permission String @db.VarChar(64)
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model RoleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  scopeType   ScopeType
  businessId  String?   @db.Uuid
  storeId     String?   @db.Uuid
  grantedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  user        User      @relation("assignee", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy   User?     @relation("grantor", fields: [grantedById], references: [id], onDelete: SetNull)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([businessId, revokedAt])
}

// ───────────────────────────── Messaging ─────────────────────────────

enum ConversationType {
  DIRECT
  GROUP
  EMERGENCY
  /// One read-only announcements channel per recipient and business (bulk campaigns, phase 6).
  BROADCAST
  /// A person's broadcast list (WhatsApp): only the owner is a member; each message is also
  /// sent to every recipient as a direct message.
  BROADCAST_LIST
}

enum PostingPolicy {
  ALL_MEMBERS
  ADMINS_ONLY
}

enum GroupCategory {
  OPERATIONS
  SECURITY
  EMERGENCY_RESPONSE
  MANAGEMENT
  ANNOUNCEMENTS
  GENERAL
}

enum FileSharingPolicy {
  ALL_MEMBERS
  ADMINS_ONLY
  DISABLED
}

enum MemberRole {
  MEMBER
  ADMIN
}

model Conversation {
  id                String            @id @default(uuid()) @db.Uuid
  businessId        String            @db.Uuid
  storeId           String?           @db.Uuid
  type              ConversationType
  title             String?           @db.VarChar(100)
  description       String?           @db.VarChar(500)
  category          GroupCategory?
  postingPolicy     PostingPolicy     @default(ALL_MEMBERS)
  fileSharingPolicy FileSharingPolicy @default(ALL_MEMBERS)
  /// Who may change the group name and description (WhatsApp "Edit group info").
  editInfoPolicy    PostingPolicy     @default(ADMINS_ONLY)
  /// Who may add people to the group (WhatsApp "Add other members").
  addMembersPolicy  PostingPolicy     @default(ADMINS_ONLY)
  /// "businessId:userA:userB" with sorted user ids; dedupes direct conversations.
  directKey         String?           @unique @db.VarChar(120)
  /// "businessId:userId" for BROADCAST channels; dedupes the per-recipient announcements channel.
  channelKey        String?           @unique @db.VarChar(80)
  /// Gap-free per-conversation message counter (ADR-0003).
  lastSeq           Int               @default(0)
  lastMessageId     String?           @unique @db.Uuid
  lastActivityAt    DateTime          @default(now()) @db.Timestamptz(3)
  memberCount       Int               @default(0)
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?         @db.Timestamptz(3)

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  store               Store?               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdBy           User?                @relation("creator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessage         Message?             @relation("lastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  members             ConversationMember[]
  messages            Message[]            @relation("messages")
  pinnedMessages      PinnedMessage[]
  mediaAssets         MediaAsset[]
  incident            EmergencyIncident?
  /// BROADCAST_LIST only: who receives the list's messages.
  broadcastRecipients BroadcastRecipient[]

  @@index([businessId])
}

model ConversationMember {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  userId           String       @db.Uuid
  role             MemberRole   @default(MEMBER)
  /// Member may read messages with seq > historyFromSeq.
  historyFromSeq   Int          @default(0)
  lastDeliveredSeq Int          @default(0)
  lastReadSeq      Int          @default(0)
  markedUnread     Boolean      @default(false)
  mutedUntil       DateTime?    @db.Timestamptz(3)
  pinnedAt         DateTime?    @db.Timestamptz(3)
  archivedAt       DateTime?    @db.Timestamptz(3)
  joinedAt         DateTime     @default(now()) @db.Timestamptz(3)
  /// Non-null when the member left or was removed: all access ends (docs D3).
  leftAt           DateTime?    @db.Timestamptz(3)
  addedById        String?      @db.Uuid
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@index([conversationId, leftAt])
}

enum MessageKind {
  TEXT
  SYSTEM
  IMAGE
  VIDEO
  DOCUMENT
  /// Voice note or audio file (the attachment); details in meta.
  AUDIO
  LOCATION
  /// A shared contact card (a person in the business).
  CONTACT
  POLL
  EVENT
  /// Voice or video call record (missed, answered, duration).
  CALL
  STICKER
}

/// Sender-side pipeline state (docs/architecture/messaging.md).
enum MessageState {
  ACCEPTED
  DISPATCHED
  FAILED
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @db.Uuid
  seq             Int
  senderId        String       @db.Uuid
  clientMessageId String       @db.Uuid
  kind            MessageKind  @default(TEXT)
  body            String?
  systemEvent     Json?
  /// Kind-specific content (location, contact, poll, event, call, voice note, sticker). Shape per
  /// kind is validated by @storeline/shared (messageMetaSchema).
  meta            Json?
  replyToId       String?      @db.Uuid
  forwardedFromId String?      @db.Uuid
  state           MessageState @default(ACCEPTED)
  failureReason   String?      @db.VarChar(120)
  editedAt        DateTime?    @db.Timestamptz(3)
  deletedAt       DateTime?    @db.Timestamptz(3)
  deletedById     String?      @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  conversation   Conversation        @relation("messages", fields: [conversationId], references: [id], onDelete: Restrict)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo        Message?            @relation("replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]           @relation("replies")
  forwardedFrom  Message?            @relation("forwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards       Message[]           @relation("forwards")
  revisions      MessageRevision[]
  reactions      MessageReaction[]
  stars          StarredMessage[]
  pins           PinnedMessage[]
  attachments    MessageAttachment[]
  hiddenBy       HiddenMessage[]
  pollVotes      PollVote[]
  eventResponses EventResponse[]
  lastMessageOf  Conversation?       @relation("lastMessage")

  @@unique([conversationId, seq])
  @@unique([senderId, clientMessageId])
}

/// "Delete for me": the message disappears for this person only.
model HiddenMessage {
  userId    String   @db.Uuid
  messageId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
}

/// A vote in a poll message (one row per chosen option).
model PollVote {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  option    Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, option])
  @@index([messageId])
}

enum EventResponseKind {
  GOING
  MAYBE
  NOT_GOING
}

/// Who is coming to an event message.
model EventResponse {
  messageId String            @db.Uuid
  userId    String            @db.Uuid
  response  EventResponseKind
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  message   Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

/// Recipients of a broadcast list (a BROADCAST_LIST conversation).
model BroadcastRecipient {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  addedAt        DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model MessageRevision {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  /// Body before the change.
  body      String?
  reason    String   @db.VarChar(16) // EDIT | DELETE
  editorId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([createdAt])
}

model MessageReaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([messageId, userId])
}

model StarredMessage {
  userId    String   @db.Uuid
  messageId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([userId, createdAt])
}

model PinnedMessage {
  conversationId String       @db.Uuid
  messageId      String       @db.Uuid
  pinnedById     String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([conversationId, messageId])
}

// ───────────────────────────── Media (phase 4) ─────────────────────────────

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

/// Lifecycle: PENDING_UPLOAD → VERIFYING → READY | QUARANTINED | REJECTED; FAILED for
/// expired or broken uploads. Only READY assets can be attached or downloaded.
enum MediaStatus {
  PENDING_UPLOAD
  VERIFYING
  READY
  QUARANTINED
  REJECTED
  FAILED
}

/// An uploaded file. Bytes live in private object storage, never in PostgreSQL.
model MediaAsset {
  id                String      @id @default(uuid()) @db.Uuid
  businessId        String      @db.Uuid
  /// Upload context: a conversation, a draft bulk campaign, or a status update (exactly one;
  /// CHECK constraint).
  conversationId    String?     @db.Uuid
  campaignId        String?     @db.Uuid
  forStatus         Boolean     @default(false)
  uploaderId        String      @db.Uuid
  kind              MediaKind
  status            MediaStatus @default(PENDING_UPLOAD)
  /// Sanitised display name; never used to build storage keys.
  fileName          String      @db.VarChar(200)
  /// Declared type from the allow-list; verified against the file signature before READY.
  mimeType          String      @db.VarChar(120)
  sizeBytes         BigInt
  /// Computed by the scanner while streaming the object.
  sha256            String?     @db.VarChar(64)
  /// Unverified bytes land here (incoming/…); download URLs are never issued for this key.
  incomingKey       String      @db.VarChar(200)
  /// Verified bytes (media/<business>/…). Set when READY.
  objectKey         String?     @db.VarChar(200)
  thumbnailKey      String?     @db.VarChar(200)
  multipartUploadId String?     @db.VarChar(1024)
  partSize          Int?
  partCount         Int?
  width             Int?
  height            Int?
  failureReason     String?     @db.VarChar(64)
  uploadExpiresAt   DateTime    @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  readyAt           DateTime?   @db.Timestamptz(3)

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  campaign     BulkCampaign?       @relation("campaignUploads", fields: [campaignId], references: [id], onDelete: Restrict)
  uploader     User                @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  attachments  MessageAttachment[]
  campaigns    BulkCampaign[]      @relation("campaignAttachment")
  statusPosts  StatusPost[]

  @@index([businessId, status])
  @@index([status, uploadExpiresAt])
  @@index([conversationId])
  @@index([campaignId])
}

model MessageAttachment {
  messageId String     @db.Uuid
  mediaId   String     @db.Uuid
  position  Int        @default(0)
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([messageId, position])
  @@index([mediaId])
}

// ───────────────────────────── Emergency (phase 5) ─────────────────────────────

/// Ordered emergency contacts of a store (1 = primary, 2 = backup, ...). A pointer to a user:
/// private contact values are never copied here (docs/architecture/emergency.md).
model EmergencyContact {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  storeId     String   @db.Uuid
  userId      String   @db.Uuid
  priority    Int
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  store       Store    @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Restrict)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([storeId, userId])
  @@unique([storeId, priority])
}

enum EmergencyCategory {
  MEDICAL
  SECURITY
  FIRE
  OTHER
  THEFT
  VIOLENCE
  ACCIDENT
  GAS_LEAK
  POWER_FAILURE
  NATURAL_DISASTER
}

/// OPEN -> (ESCALATED)* -> ACKNOWLEDGED -> RESOLVED; OPEN/ESCALATED -> CANCELLED by the reporter.
enum IncidentStatus {
  OPEN
  ESCALATED
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

model EmergencyIncident {
  id                String            @id @default(uuid()) @db.Uuid
  businessId        String            @db.Uuid
  storeId           String            @db.Uuid
  reporterId        String            @db.Uuid
  /// Client-generated idempotency key (unique per reporter).
  clientIncidentId  String            @db.Uuid
  conversationId    String            @unique @db.Uuid
  category          EmergencyCategory @default(OTHER)
  description       String?           @db.VarChar(1000)
  status            IncidentStatus    @default(OPEN)
  /// Current escalation level (1 = primary contact).
  level             Int               @default(1)
  /// Number of levels in the escalation chain snapshot taken at creation.
  maxLevel          Int
  ackTimeoutSeconds Int
  /// When the current level escalates. null once acknowledged, closed, or the chain is exhausted.
  ackDeadlineAt     DateTime?         @db.Timestamptz(3)
  chainExhaustedAt  DateTime?         @db.Timestamptz(3)
  acknowledgedAt    DateTime?         @db.Timestamptz(3)
  acknowledgedById  String?           @db.Uuid
  resolvedAt        DateTime?         @db.Timestamptz(3)
  resolvedById      String?           @db.Uuid
  resolutionNote    String?           @db.VarChar(500)
  cancelledAt       DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  business       Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  store          Store                        @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Restrict)
  reporter       User                         @relation("incidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  acknowledgedBy User?                        @relation("incidentAcknowledger", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  resolvedBy     User?                        @relation("incidentResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  conversation   Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  recipients     EmergencyIncidentRecipient[]
  events         EmergencyIncidentEvent[]

  @@unique([reporterId, clientIncidentId])
  @@index([businessId, storeId, createdAt])
  @@index([status, ackDeadlineAt])
}

/// Per-recipient notification state. Queuing an alert never marks it delivered:
/// QUEUED -> SENT_TO_GATEWAY (worker emitted it) -> DELIVERED_TO_DEVICE (client confirmed)
/// -> READ (opened) -> ACKNOWLEDGED. PENDING = later escalation level, not yet alerted.
enum AlertState {
  PENDING
  QUEUED
  SENT_TO_GATEWAY
  DELIVERED_TO_DEVICE
  READ
  ACKNOWLEDGED
  FAILED
  SKIPPED
}

/// Why the user is in the escalation chain.
enum ResponderSource {
  CONTACT
  STORE_MANAGER
  BUSINESS_ADMIN
  /// Joined through the incident.acknowledge permission (e.g. security on shift).
  RESPONDER
}

model EmergencyIncidentRecipient {
  id             String            @id @default(uuid()) @db.Uuid
  incidentId     String            @db.Uuid
  userId         String            @db.Uuid
  level          Int
  source         ResponderSource
  state          AlertState        @default(PENDING)
  notifiedAt     DateTime?         @db.Timestamptz(3)
  sentAt         DateTime?         @db.Timestamptz(3)
  deliveredAt    DateTime?         @db.Timestamptz(3)
  readAt         DateTime?         @db.Timestamptz(3)
  acknowledgedAt DateTime?         @db.Timestamptz(3)
  failedAt       DateTime?         @db.Timestamptz(3)
  failureReason  String?           @db.VarChar(64)
  incident       EmergencyIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([incidentId, userId])
  @@index([userId, state])
}

enum IncidentEventType {
  CREATED
  NOTIFIED
  ESCALATED
  RECIPIENT_SKIPPED
  CHAIN_EXHAUSTED
  NOTIFY_FAILED
  JOINED
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

/// Append-only incident timeline (the emergency history shown to responders).
model EmergencyIncidentEvent {
  id         String            @id @default(uuid()) @db.Uuid
  /// Total order of the timeline (events of one transaction share createdAt).
  seq        Int               @default(autoincrement())
  incidentId String            @db.Uuid
  type       IncidentEventType
  actorId    String?           @db.Uuid
  level      Int?
  /// User ids affected (notified, skipped, ...). Never contact values.
  userIds    String[]          @db.Uuid
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  incident   EmergencyIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  @@index([incidentId, seq])
}

// ───────────────────────────── Bulk campaigns (phase 6) ─────────────────────────────

/// DRAFT -> SCHEDULED -> SENDING <-> PAUSED -> COMPLETED; DRAFT/SCHEDULED/SENDING/PAUSED -> CANCELLED.
enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
}

/// Recipient pipeline state. Delivery and read are derived from the channel watermarks.
enum CampaignRecipientState {
  PENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

model BulkCampaign {
  id               String         @id @default(uuid()) @db.Uuid
  businessId       String         @db.Uuid
  createdById      String         @db.Uuid
  /// Idempotency key from the client (unique per creator).
  clientCampaignId String         @db.Uuid
  name             String         @db.VarChar(120)
  description      String?        @db.VarChar(500)
  body             String?
  mediaId          String?        @db.Uuid
  /// CampaignAudience JSON (validated by @storeline/shared campaignAudienceSchema).
  audience         Json
  status           CampaignStatus @default(DRAFT)
  scheduledAt      DateTime?      @db.Timestamptz(3)
  /// PENDING recipients are skipped after this time.
  expiresAt        DateTime?      @db.Timestamptz(3)
  startedAt        DateTime?      @db.Timestamptz(3)
  /// Recipients snapshotted (audience resolved) at this time.
  materializedAt   DateTime?      @db.Timestamptz(3)
  pausedAt         DateTime?      @db.Timestamptz(3)
  completedAt      DateTime?      @db.Timestamptz(3)
  cancelledAt      DateTime?      @db.Timestamptz(3)
  /// Recipient count the sender confirmed for a large broadcast.
  confirmedCount   Int?
  totalRecipients  Int            @default(0)
  /// Round-robin fairness across tenants: least recently served first.
  lastDispatchAt   DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  business   Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy  User                    @relation("campaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  media      MediaAsset?             @relation("campaignAttachment", fields: [mediaId], references: [id], onDelete: Restrict)
  uploads    MediaAsset[]            @relation("campaignUploads")
  recipients BulkCampaignRecipient[]

  @@unique([createdById, clientCampaignId])
  @@index([businessId, createdAt])
  @@index([status, scheduledAt])
}

model BulkCampaignRecipient {
  campaignId  String                 @db.Uuid
  userId      String                 @db.Uuid
  state       CampaignRecipientState @default(PENDING)
  /// The message written to the recipient's announcements channel.
  messageId   String?                @unique @db.Uuid
  reason      String?                @db.VarChar(64)
  processedAt DateTime?              @db.Timestamptz(3)
  campaign    BulkCampaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([campaignId, userId])
  @@index([campaignId, state])
}

/// People who must not receive campaigns from a business (admin suppression or self opt-out).
model CampaignSuppression {
  businessId  String   @db.Uuid
  userId      String   @db.Uuid
  /// ADMIN or SELF_OPT_OUT
  reason      String   @db.VarChar(32)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user        User     @relation("suppressedUser", fields: [userId], references: [id], onDelete: Restrict)

  @@id([businessId, userId])
}

// ───────────────────────────── Devices and notifications (phase 8) ─────────────────────────────

enum DevicePlatform {
  WEB
  DESKTOP
  IOS
  ANDROID
}

enum PushProvider {
  WEB_PUSH
  FCM
  APNS
}

/// A signed-in client. Bound 1:1 to its session: revoking the session (sign out, password
/// change, admin action) ends the device and its push registration with it.
model Device {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  sessionId     String         @unique @db.Uuid
  platform      DevicePlatform
  name          String         @db.VarChar(80)
  appVersion    String?        @db.VarChar(32)
  pushProvider  PushProvider?
  /// AES-256-GCM encrypted push token / Web Push subscription (it lets anyone push to the device).
  pushTokenEnc  String?
  /// Keyed hash of the push endpoint/token: one registration per physical device.
  pushTokenHash String?        @unique @db.VarChar(64)
  pushUpdatedAt DateTime?      @db.Timestamptz(3)
  lastPushAt    DateTime?      @db.Timestamptz(3)
  lastPushError String?        @db.VarChar(120)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  session       Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// What appears on lock screens. Defaults keep message content off the lock screen.
enum PushPreview {
  /// "New message" only
  NONE
  /// Sender and conversation name, no content
  SENDER
  /// Message text (only where the business allows it)
  CONTENT
}

model NotificationPreference {
  userId      String      @id @db.Uuid
  pushEnabled Boolean     @default(true)
  preview     PushPreview @default(NONE)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// ───────────────────────────── Reliability & audit ─────────────────────────────

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  type        String       @db.VarChar(64)
  businessId  String?      @db.Uuid
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?    @db.Timestamptz(3)
  lastError   String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([publishedAt])
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only. Never store message bodies, secrets, tokens or contact values in metadata.
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)
  actorUserId    String?      @db.Uuid
  actorSessionId String?      @db.Uuid
  action         String       @db.VarChar(80)
  outcome        AuditOutcome @default(SUCCESS)
  businessId     String?      @db.Uuid
  storeId        String?      @db.Uuid
  targetType     String?      @db.VarChar(40)
  targetId       String?      @db.Uuid
  metadata       Json         @default("{}")
  requestId      String?      @db.VarChar(64)
  ipHash         String?      @db.VarChar(64)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([businessId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
}

// ───────────────────────────── Status updates ─────────────────────────────

/// A 24-hour post (WhatsApp Status), seen by the people of its business (or of one store).
model StatusPost {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  /// Only this store's people see it (store announcements); null = the whole business.
  storeId    String?      @db.Uuid
  authorId   String       @db.Uuid
  /// Text post: the text; photo/video post: the caption.
  text       String?      @db.VarChar(700)
  /// Background colour of a text post (#rrggbb).
  background String?      @db.VarChar(7)
  mediaId    String?      @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime     @db.Timestamptz(3)
  deletedAt  DateTime?    @db.Timestamptz(3)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  store      Store?       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  media      MediaAsset?  @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  views      StatusView[]

  @@index([businessId, expiresAt])
  @@index([authorId, createdAt])
}

model StatusView {
  statusId String     @db.Uuid
  userId   String     @db.Uuid
  viewedAt DateTime   @default(now()) @db.Timestamptz(3)
  status   StatusPost @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([statusId, userId])
}

// ───────────────────────────── Store tasks and shifts ─────────────────────────────

enum TaskStatus {
  OPEN
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A to-do for a store. Managers assign; the assignee (or anyone in the store, when
/// unassigned) marks it done.
model StoreTask {
  id            String       @id @default(uuid()) @db.Uuid
  businessId    String       @db.Uuid
  storeId       String       @db.Uuid
  title         String       @db.VarChar(160)
  notes         String?      @db.VarChar(2000)
  priority      TaskPriority @default(NORMAL)
  status        TaskStatus   @default(OPEN)
  dueAt         DateTime?    @db.Timestamptz(3)
  assigneeId    String?      @db.Uuid
  createdById   String?      @db.Uuid
  completedById String?      @db.Uuid
  completedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?    @db.Timestamptz(3)
  store         Store        @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Restrict)
  assignee      User?        @relation("taskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User?        @relation("taskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy   User?        @relation("taskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([assigneeId, status])
}

/// A planned work shift of one person in one store.
model Shift {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  storeId     String   @db.Uuid
  userId      String   @db.Uuid
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  /// e.g. "Morning", "Cashier", "Stock room"
  title       String?  @db.VarChar(60)
  notes       String?  @db.VarChar(300)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  store       Store    @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Restrict)
  user        User     @relation("shiftUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("shiftCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, startsAt])
  @@index([userId, startsAt])
}

// ───────────────────────────── Platform settings ─────────────────────────────

/// Settings the Super Admin changes in the app (e.g. email/SMS/WhatsApp provider keys).
/// Values are AES-256-GCM encrypted; they override the matching environment variables.
model PlatformSetting {
  key         String   @id @db.VarChar(64)
  valueEnc    String
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

// ───────────────────────────── Sales & Marketing ─────────────────────────────
// Prospects for SMA itself (businesses that may buy SMA), not customers of a business.

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  COLD_CALL
  REFERRAL
  SOCIAL_MEDIA
  EMAIL_CAMPAIGN
  EVENT
  WALK_IN
  PARTNER
  ADVERTISEMENT
  OTHER
}

enum LeadDirection {
  INBOUND
  OUTBOUND
}

/// What the prospect said or did after a call or message.
enum ActivityOutcome {
  INTERESTED
  NOT_INTERESTED
  NO_ANSWER
  CALL_BACK_LATER
  MEETING_BOOKED
  NEEDS_MORE_INFO
  WRONG_CONTACT
}

enum LeadActivityType {
  CREATED
  NOTE
  CALL
  EMAIL
  MEETING
  WHATSAPP
  STAGE_CHANGED
  ASSIGNED
  CONVERTED
}

model Lead {
  id                  String           @id @default(uuid()) @db.Uuid
  companyName         String           @db.VarChar(120)
  contactName         String           @db.VarChar(80)
  contactTitle        String?          @db.VarChar(80)
  email               String?          @db.VarChar(254)
  phone               String?          @db.VarChar(16)
  website             String?          @db.VarChar(500)
  industry            String?          @db.VarChar(80)
  city                String?          @db.VarChar(100)
  country             String?          @db.VarChar(2)
  storeCount          Int?
  /// Expected monthly value of the deal, whole currency units.
  estimatedValue      Int?
  currency            String           @default("PKR") @db.VarChar(3)
  source              LeadSource
  /// Inbound: they came to us (website, referral…). Outbound: we reached out (cold call…).
  direction           LeadDirection    @default(INBOUND)
  /// When the lead entered its current stage (shows leads that are stuck).
  stageChangedAt      DateTime         @default(now()) @db.Timestamptz(3)
  callCount           Int              @default(0)
  messageCount        Int              @default(0)
  meetingCount        Int              @default(0)
  lastOutcome         ActivityOutcome?
  sourceDetail        String?          @db.VarChar(160)
  stage               LeadStage        @default(NEW)
  lostReason          String?          @db.VarChar(300)
  /// When the lead was marked WON or LOST (cleared if reopened).
  closedAt            DateTime?        @db.Timestamptz(3)
  notes               String?          @db.VarChar(2000)
  ownerId             String?          @db.Uuid
  createdById         String?          @db.Uuid
  nextFollowUpAt      DateTime?        @db.Timestamptz(3)
  lastActivityAt      DateTime         @default(now()) @db.Timestamptz(3)
  convertedBusinessId String?          @unique @db.Uuid
  convertedAt         DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?        @db.Timestamptz(3)

  owner             User?          @relation("leadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy         User?          @relation("leadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  convertedBusiness Business?      @relation("leadCustomer", fields: [convertedBusinessId], references: [id], onDelete: SetNull)
  activities        LeadActivity[]
  deals             Deal[]
  invoices          Invoice[]

  @@index([stage, deletedAt])
  @@index([ownerId, stage])
  @@index([nextFollowUpAt])
}

model LeadActivity {
  id        String           @id @default(uuid()) @db.Uuid
  leadId    String           @db.Uuid
  type      LeadActivityType
  body      String?          @db.VarChar(2000)
  outcome   ActivityOutcome?
  fromStage LeadStage?
  toStage   LeadStage?
  actorId   String?          @db.Uuid
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

// ───────────────────────────── Store customers ─────────────────────────────
/// A business's own customers (not SMA's customers), recorded for future marketing.
model StoreCustomer {
  id                 String                      @id @default(uuid()) @db.Uuid
  businessId         String                      @db.Uuid
  /// The store where they shop most (optional).
  storeId            String?                     @db.Uuid
  name               String                      @db.VarChar(120)
  phone              String?                     @db.VarChar(16)
  email              String?                     @db.VarChar(254)
  city               String?                     @db.VarChar(100)
  notes              String?                     @db.VarChar(1000)
  tags               String[]
  /// The customer agreed to receive marketing. Only these are exported for campaigns.
  marketingOptIn     Boolean                     @default(false)
  optInAt            DateTime?                   @db.Timestamptz(3)
  /// When they used an unsubscribe link (marketing then stays off until they agree again).
  unsubscribedAt     DateTime?                   @db.Timestamptz(3)
  campaignDeliveries CustomerCampaignRecipient[]
  createdById        String?                     @db.Uuid
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?                   @db.Timestamptz(3)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, deletedAt])
  @@index([storeId])
}

enum MarketingChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum CustomerCampaignStatus {
  DRAFT
  SENDING
  COMPLETED
  CANCELLED
}

/// SENT = accepted by the email/SMS/WhatsApp provider (not proof it reached the person).
enum CustomerRecipientState {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// A marketing message from a business to its opted-in store customers.
model CustomerCampaign {
  id          String                 @id @default(uuid()) @db.Uuid
  businessId  String                 @db.Uuid
  name        String                 @db.VarChar(120)
  channel     MarketingChannel
  subject     String?                @db.VarChar(150)
  body        String                 @db.VarChar(1500)
  /// { storeIds: string[], tags: string[] }
  audience    Json
  status      CustomerCampaignStatus @default(DRAFT)
  createdById String?                @db.Uuid
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  startedAt   DateTime?              @db.Timestamptz(3)
  completedAt DateTime?              @db.Timestamptz(3)

  business   Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy  User?                       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients CustomerCampaignRecipient[]

  @@index([businessId, createdAt])
  @@index([status])
}

model CustomerCampaignRecipient {
  id                String                 @id @default(uuid()) @db.Uuid
  campaignId        String                 @db.Uuid
  customerId        String                 @db.Uuid
  /// Email address or phone number at the time of sending.
  destination       String                 @db.VarChar(254)
  state             CustomerRecipientState @default(PENDING)
  providerMessageId String?                @db.VarChar(200)
  error             String?                @db.VarChar(300)
  sentAt            DateTime?              @db.Timestamptz(3)
  campaign          CustomerCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer          StoreCustomer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId, state])
}

// ───────────────────────────── CRM: services, deals, invoices, payments, targets ─────────────────────────────

enum ServiceBilling {
  ONE_TIME
  MONTHLY
  YEARLY
}

/// What SMA sells (plans, add-ons, setup, training…). Deals and invoices copy name and price.
model CrmService {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(120)
  description  String?        @db.VarChar(1000)
  category     String?        @db.VarChar(60)
  price        Decimal        @db.Decimal(12, 2)
  billing      ServiceBilling @default(ONE_TIME)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  dealItems    DealItem[]
  invoiceItems InvoiceItem[]
}

enum DealType {
  /// Winning a new customer (from a lead).
  NEW_BUSINESS
  /// Selling more to an existing customer.
  UPSELL
  RENEWAL
}

enum DealStatus {
  OPEN
  WON
  LOST
}

/// A sale: which services, to whom, for how much. Won deals count towards the owner's target.
model Deal {
  id              String     @id @default(uuid()) @db.Uuid
  title           String     @db.VarChar(160)
  type            DealType
  status          DealStatus @default(OPEN)
  /// New business: the lead it comes from.
  leadId          String?    @db.Uuid
  /// The SMA customer (always set for upsells; set for new business once the lead converts).
  businessId      String?    @db.Uuid
  ownerId         String?    @db.Uuid
  /// Sum of the items.
  amount          Decimal    @default(0) @db.Decimal(12, 2)
  currency        String     @db.VarChar(3)
  expectedCloseAt DateTime?  @db.Timestamptz(3)
  /// When it was marked WON or LOST.
  closedAt        DateTime?  @db.Timestamptz(3)
  lostReason      String?    @db.VarChar(300)
  notes           String?    @db.VarChar(2000)
  createdById     String?    @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?  @db.Timestamptz(3)
  lead            Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  business        Business?  @relation("customerDeals", fields: [businessId], references: [id], onDelete: Restrict)
  owner           User?      @relation("dealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy       User?      @relation("dealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items           DealItem[]
  invoices        Invoice[]

  @@index([ownerId, status])
  @@index([status, closedAt])
  @@index([businessId])
  @@index([leadId])
}

model DealItem {
  id          String         @id @default(uuid()) @db.Uuid
  dealId      String         @db.Uuid
  serviceId   String?        @db.Uuid
  name        String         @db.VarChar(160)
  quantity    Int
  unitPrice   Decimal        @db.Decimal(12, 2)
  /// Percentage discount on this line (0–100).
  discountPct Decimal        @default(0) @db.Decimal(5, 2)
  total       Decimal        @db.Decimal(12, 2)
  billing     ServiceBilling @default(ONE_TIME)
  position    Int            @default(0)
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  service     CrmService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([dealId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// A bill to an SMA customer (or a lead before conversion). Totals are kept in sync with items
/// and payments by the API; "overdue" = issued, unpaid and past the due date.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  /// INV-2026-00001
  number        String        @unique @db.VarChar(20)
  dealId        String?       @db.Uuid
  businessId    String?       @db.Uuid
  leadId        String?       @db.Uuid
  billToName    String        @db.VarChar(160)
  billToEmail   String?       @db.VarChar(254)
  billToPhone   String?       @db.VarChar(16)
  billToAddress String?       @db.VarChar(500)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  currency      String        @db.VarChar(3)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?       @db.VarChar(2000)
  createdById   String?       @db.Uuid
  issuedAt      DateTime?     @db.Timestamptz(3)
  paidAt        DateTime?     @db.Timestamptz(3)
  voidedAt      DateTime?     @db.Timestamptz(3)
  voidReason    String?       @db.VarChar(300)
  lastEmailedAt DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  deal          Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  business      Business?     @relation("customerInvoices", fields: [businessId], references: [id], onDelete: Restrict)
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("invoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]

  @@index([status, dueDate])
  @@index([businessId])
  @@index([dealId])
}

model InvoiceItem {
  id          String      @id @default(uuid()) @db.Uuid
  invoiceId   String      @db.Uuid
  serviceId   String?     @db.Uuid
  name        String      @db.VarChar(160)
  description String?     @db.VarChar(500)
  quantity    Int
  unitPrice   Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  position    Int         @default(0)
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     CrmService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  ONLINE
  OTHER
}

/// Money received against an invoice. Voided payments stay for the record.
model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime      @db.Timestamptz(3)
  method       PaymentMethod
  reference    String?       @db.VarChar(120)
  notes        String?       @db.VarChar(500)
  recordedById String?       @db.Uuid
  voidedAt     DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User?         @relation("paymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paidAt])
}

/// A sales person's goal for one month (won deal value). History stays month by month.
model SalesTarget {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  /// First day of the month.
  month     DateTime @db.Date
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @db.VarChar(3)
  setById   String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation("salesTargets", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}
