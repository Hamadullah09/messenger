# Where the Next.js server proxies /api/* (server-side only).
API_ORIGIN=http://localhost:4000
# Public Socket.IO origin used by browsers (the API process).
# Leave unset in development: the browser uses port 4000 of the computer that served the page
# (works from phones on the same Wi-Fi). Set it for a fixed production address.
# NEXT_PUBLIC_REALTIME_URL=https://api.example.com
# Object storage origin for signed upload/download URLs (CSP).
# Leave unset in development (storage on port 18333 of the same computer). Production: set it.
# NEXT_PUBLIC_MEDIA_ORIGIN=https://media.example.com
